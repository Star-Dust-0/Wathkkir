<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.widgethost">
    <queries><package android:name="com.wathakker.app"/><package android:name="com.wathakker.app.compare"/></queries>
    <instrumentation android:name="com.example.widgethost.HierarchyDump" android:targetPackage="${applicationId}"/>
    <instrumentation android:name="com.example.widgethost.WatchEngineProbe" android:targetPackage="${applicationId}"/>
    <instrumentation android:name="com.example.widgethost.ScrollAction" android:targetPackage="${applicationId}"/>
    <instrumentation android:name="com.example.widgethost.SliderAction" android:targetPackage="${applicationId}"/>
    <application android:label="WidgetHost" android:icon="@android:drawable/sym_def_app_icon" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
