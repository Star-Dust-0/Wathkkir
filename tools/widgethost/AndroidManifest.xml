    <instrumentation android:name=".HierarchyDump" android:targetPackage="com.example.widgethost"/>
    <instrumentation android:name=".WatchEngineProbe" android:targetPackage="com.example.widgethost"/>
    <application android:label="WidgetHost" android:icon="@android:drawable/sym_def_app_icon" android:theme="@android:style/Theme.Material.NoActionBar">
