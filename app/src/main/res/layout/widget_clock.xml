<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_clock_prev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العشاء"
            android:textColor="#FFA6A6A6"
            android:textSize="13sp"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_clock_prev_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7:54"
            android:textColor="#FFA6A6A6"
            android:textSize="13sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_clock_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:format="%s"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/widget_clock_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الفجر"
            android:textColor="#FF3E91FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_clock_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5:34"
            android:textColor="#FF3E91FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
