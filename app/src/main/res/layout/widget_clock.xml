<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_clock_prev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العشاء"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"
            android:textAlignment="center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_clock_prev_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="7:54"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"
            android:textAlignment="center"/>
    </LinearLayout>
    <Chronometer
        android:textSize="28sp"
        android:textColor="#ffffffff"
        android:id="@+id/widget_clock_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format="%s"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_semibold"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_clock_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الفجر"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"
            android:textAlignment="center"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_clock_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="5:34"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"
            android:textAlignment="center"/>
    </LinearLayout>
</LinearLayout>
