<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hero_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_hero_compact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العصر 4:07"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_hero_compact_remaining"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="باقي 2 س 27 د"
            android:textColor="#FFE5B455"
            android:textSize="13sp"
            android:textDirection="locale" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_hero_compact_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_white" />
</LinearLayout>
