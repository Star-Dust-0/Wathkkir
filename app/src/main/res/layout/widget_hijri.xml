<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <TextView
        android:textSize="26sp"
        android:textColor="#ffffffff"
        android:id="@+id/widget_hijri_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="29"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:id="@+id/widget_hijri_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ربيع الآخر"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffc9c9ce"
        android:id="@+id/widget_hijri_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1447 هـ"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
</LinearLayout>
