<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/facewidget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layoutDirection="rtl"
    android:background="@drawable/facewidget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/facewidget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العصر"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/facewidget_prayer_time"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="4:07 م"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textDirection="locale" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/facewidget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_white" />

    <TextView
        android:id="@+id/facewidget_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="right"
        android:text="باقي على صلاة العصر 2 س 27 د"
        android:textColor="#FFC9C9CE"
        android:textSize="13sp"
        android:textDirection="locale" />
</LinearLayout>
