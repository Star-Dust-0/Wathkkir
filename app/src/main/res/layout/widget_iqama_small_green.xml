<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الإقامة"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
    <ProgressBar
        android:id="@+id/widget_iqama_small_progress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:maxHeight="10dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_green"
        android:minHeight="0dp"
        android:layoutDirection="ltr"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffc9c9ce"
        android:gravity="center"
        android:id="@+id/widget_iqama_small_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="5:59"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_semibold"
        android:textDirection="rtl"/>
</LinearLayout>
