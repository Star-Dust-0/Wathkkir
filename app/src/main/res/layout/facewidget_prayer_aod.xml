<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/facewidget_root"
    android:background="@drawable/facewidget_bg_aod"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@+id/facewidget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العصر"
            android:textDirection="locale"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="left"
            android:id="@+id/facewidget_prayer_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="4:07 م"
            android:layout_weight="1"
            android:textDirection="locale"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/facewidget_progress"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_white"
        android:layoutDirection="ltr"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffc9c9ce"
        android:gravity="right"
        android:id="@+id/facewidget_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="باقي على صلاة العصر 2 س 27 د"
        android:textDirection="locale"/>
</LinearLayout>
