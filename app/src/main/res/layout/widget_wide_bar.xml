<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/widget_wide_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="السبت"
            android:textColor="#FFA6A6A6"
            android:textSize="11sp"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_wide_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="القاهرة"
            android:textColor="#FFA6A6A6"
            android:textSize="11sp"
            android:textDirection="locale" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:id="@+id/widget_wide_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="الفجر"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_wide_prev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="العشاء"
            android:textColor="#FFA6A6A6"
            android:textSize="17sp"
            android:textDirection="locale" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/widget_wide_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_white" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/widget_wide_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="5:34"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_wide_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="باقي على الفجر 19 دقيقة"
            android:textColor="#FF3E91FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_wide_prev_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="7:54"
            android:textColor="#FFA6A6A6"
            android:textSize="13sp" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/widget_wide_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="29 ربيع الثاني 1448"
            android:textColor="#FFA6A6A6"
            android:textSize="11sp"
            android:textDirection="locale" />
        <TextView
            android:id="@+id/widget_wide_greg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="10 أكتوبر 2026"
            android:textColor="#FFA6A6A6"
            android:textSize="11sp"
            android:textDirection="locale" />
    </RelativeLayout>
</LinearLayout>
