<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/widget_hero_root"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24sp"
            android:textColor="#ffffffff"
            android:id="@+id/widget_hero_prev_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="24sp"
            android:textColor="#ffffffff"
            android:gravity="left"
            android:id="@+id/widget_hero_next_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="العصر"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_hero_progress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:maxHeight="10dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress"
        android:minHeight="0dp"
        android:layoutDirection="ltr"
        style="?android:attr/progressBarStyleHorizontal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffffff"
            android:id="@+id/widget_hero_prev_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:50"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffe5b455"
            android:gravity="center"
            android:id="@+id/widget_hero_remaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="باقي على صلاة العصر 2 س 27 د"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffffff"
            android:id="@+id/widget_hero_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:07"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:id="@+id/widget_hero_greg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 أكتوبر 2026"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="left"
            android:id="@+id/widget_hero_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="29 ربيع الثاني 1448"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
    </LinearLayout>
</LinearLayout>
