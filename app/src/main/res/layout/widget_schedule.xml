<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="الفجر"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="الشروق"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="العصر"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="المغرب"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:gravity="center"
            android:id="@+id/widget_name_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="العشاء"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="5:34"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="7:01"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="12:50"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="4:07"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="6:36"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/widget_time_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="7:54"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
    </LinearLayout>
</LinearLayout>
