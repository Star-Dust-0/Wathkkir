<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffffff"
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:50 م"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"/>
    </LinearLayout>
    <Chronometer
        android:textSize="12sp"
        android:textColor="#ffc9c9ce"
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:format="باقي %s"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"/>
</LinearLayout>
