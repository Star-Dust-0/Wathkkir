<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22sp"
                android:textColor="#ffffffff"
                android:id="@+id/widget_iqama_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 دقيقة"
                android:includeFontPadding="false"
                android:fontFamily="@font/expoarabic_medium"
                android:textDirection="rtl"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffc9c9ce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حتى الإقامة"
                android:includeFontPadding="false"
                android:fontFamily="@font/expoarabic_medium"
                android:textDirection="rtl"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/widget_mosque"
            android:contentDescription="@null"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/widget_iqama_progress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:maxHeight="10dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress"
        android:minHeight="0dp"
        android:layoutDirection="ltr"
        style="?android:attr/progressBarStyleHorizontal"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:id="@+id/widget_iqama_adhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الفجر 5:34"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_medium"
            android:textDirection="rtl"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffc9c9ce"
            android:id="@+id/widget_iqama_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الإقامة 5:59"
            android:includeFontPadding="false"
            android:fontFamily="@font/expoarabic_semibold"
            android:textDirection="rtl"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:background="#33ffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffe5b455"
        android:gravity="start"
        android:id="@+id/widget_iqama_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="الإقامة 1:10"
        android:includeFontPadding="false"
        android:fontFamily="@font/expoarabic_medium"
        android:textDirection="rtl"/>
</LinearLayout>
